{%- unless mi_seccion_css_loaded -%}
  {%- assign mi_seccion_css_loaded = true -%}
  {{ 'menu-coleccion.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

<section id="menu_coleccion" class="menu_coleccion">
  <div class="contenedor">
    <div class="left-element">
      <div class="logo">
        {% assign img = section.settings.imagen %}

        {% if img %}
          <img
            src="{{ img | image_url: width: section.settings.ancho | default: 320 }}"
            alt="{{ section.settings.alt | default: product.title | escape }}"
            loading="lazy"
          >
        {% endif %}
      </div>
      <div class="share">
        {% if collection %}
          <h2 class="brand-title">{{ collection.title | escape }}</h2>
        {% endif %}
        <button id="btn-share" type="button">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24">
            <path d="M9.71019 6.70994L11.0002 5.40994V13.9999C11.0002 14.2652 11.1055 14.5195 11.2931 14.707C11.4806 14.8946 11.735 14.9999 12.0002 14.9999C12.2654 14.9999 12.5198 14.8946 12.7073 14.707C12.8948 14.5195 13.0002 14.2652 13.0002 13.9999V5.40994L14.2902 6.70994C14.3831 6.80367 14.4937 6.87806 14.6156 6.92883C14.7375 6.9796 14.8682 7.00574 15.0002 7.00574C15.1322 7.00574 15.2629 6.9796 15.3848 6.92883C15.5066 6.87806 15.6172 6.80367 15.7102 6.70994C15.8039 6.61698 15.8783 6.50637 15.9291 6.38452C15.9798 6.26266 16.006 6.13195 16.006 5.99994C16.006 5.86793 15.9798 5.73722 15.9291 5.61536C15.8783 5.4935 15.8039 5.3829 15.7102 5.28994L12.7102 2.28994C12.6172 2.19621 12.5066 2.12182 12.3848 2.07105C12.2629 2.02028 12.1322 1.99414 12.0002 1.99414C11.8682 1.99414 11.7375 2.02028 11.6156 2.07105C11.4937 2.12182 11.3831 2.19621 11.2902 2.28994L8.29019 5.28994C8.10188 5.47824 7.99609 5.73364 7.99609 5.99994C7.99609 6.26624 8.10188 6.52164 8.29019 6.70994C8.47849 6.89824 8.73388 7.00403 9.00019 7.00403C9.26649 7.00403 9.52188 6.89824 9.71019 6.70994Z" fill="#0F1111"></path><path d="M18 9H15V11H18V20H6V11H9V9H6C5.46957 9 4.96086 9.21071 4.58579 9.58579C4.21071 9.96086 4 10.4696 4 11V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V11C20 10.4696 19.7893 9.96086 19.4142 9.58579C19.0391 9.21071 18.5304 9 18 9Z" fill="#0F1111"></path>
          </svg>
        </button>
      </div>

      {% assign subs = null %}
      {% if product and product.metafields.custom.sub_colecciones != blank %}
        {% assign subs = product.metafields.custom.sub_colecciones.value %}
      {% elsif collection and collection.metafields.custom.sub_colecciones != blank %}
        {% assign subs = collection.metafields.custom.sub_colecciones.value %}
      {% endif %}

      <div class="listado-sub-marcas">
        {% for col in subs %}
          <a class="title-sub-marca" href="{{ col.url }}">
            {{ col.title }}
          </a>
        {% endfor %}
      </div>
    </div>
    <div class="right-form--search">
      <form>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          data-testid="magnifying-glass-icon"
        >
          <path d="M20.71 19.29L17.31 15.9C18.4084 14.5032 19.0038 12.7769 19 11C19 9.41775 18.5308 7.87103 17.6518 6.55544C16.7727 5.23985 15.5233 4.21447 14.0615 3.60897C12.5997 3.00347 10.9911 2.84504 9.43928 3.15372C7.88743 3.4624 6.46197 4.22433 5.34315 5.34315C4.22433 6.46197 3.4624 7.88743 3.15372 9.43928C2.84504 10.9911 3.00347 12.5997 3.60897 14.0615C4.21447 15.5233 5.23985 16.7727 6.55544 17.6518C7.87103 18.5308 9.41775 19 11 19C12.7769 19.0038 14.5032 18.4084 15.9 17.31L19.29 20.71C19.383 20.8037 19.4936 20.8781 19.6154 20.9289C19.7373 20.9797 19.868 21.0058 20 21.0058C20.132 21.0058 20.2627 20.9797 20.3846 20.9289C20.5064 20.8781 20.617 20.8037 20.71 20.71C20.8037 20.617 20.8781 20.5064 20.9289 20.3846C20.9797 20.2627 21.0058 20.132 21.0058 20C21.0058 19.868 20.9797 19.7373 20.9289 19.6154C20.8781 19.4936 20.8037 19.383 20.71 19.29ZM5 11C5 9.81332 5.3519 8.65328 6.01119 7.66658C6.67047 6.67989 7.60755 5.91085 8.7039 5.45673C9.80026 5.0026 11.0067 4.88378 12.1705 5.11529C13.3344 5.3468 14.4035 5.91825 15.2426 6.75736C16.0818 7.59648 16.6532 8.66558 16.8847 9.82946C17.1162 10.9933 16.9974 12.1997 16.5433 13.2961C16.0892 14.3925 15.3201 15.3295 14.3334 15.9888C13.3467 16.6481 12.1867 17 11 17C9.4087 17 7.88258 16.3679 6.75736 15.2426C5.63214 14.1174 5 12.5913 5 11Z" fill="#0F1111"></path>
        </svg>
        <input type="text" placeholder="Buscar todo {{ collection.title | escape }}">
      </form>
    </div>
  </div>
</section>

<script>
  if (document.querySelector('#btn-share')) {
    document.addEventListener('click', async (e) => {
      if (!e.target.closest('#btn-share')) return;

      const title = document.title;
      const url = '{{ canonical_url | default: request.origin | append: request.path }}';

      if (navigator.share) {
        try {
          await navigator.share({ title, text: title, url });
        } catch (_) {}
      } else {
        try {
          await navigator.clipboard.writeText(url);
          alert('Vínculo copiado');
        } catch {
          prompt('Copia este vínculo:', url);
        }
      }
    });
  }
</script>

{% schema %}
{
  "name": "Mi sección personalizada",
  "settings": [
    {
      "type": "image_picker",
      "id": "imagen",
      "label": "Imagen Logo"
    }
  ],
  "presets": [
    {
      "name": "Menú colección",
      "category": "Custom"
    }
  ]
}
{% endschema %}
