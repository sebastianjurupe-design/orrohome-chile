<!doctype html>
{%- capture dir -%}
	{%- case request.locale.iso_code -%}
	  {%- when 'ae' or 'ar' or 'arc' or 'bcc' or 'bqi' or 'ckb' or 'dv' or 'fa' or 'glk' or 'ha' or 'he' or 'he-IL' or 'kwh' or 'ks' or 'ku' or 'mzn' or 'nqo' or 'pnb' or 'ps' or 'sd' or 'ug' or 'ur' or 'yi' -%}
	    rtl
	  {%- else -%}
	    ltr
	{%- endcase -%}
{%- endcapture -%}
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_body_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {% render 'head-preload' %}

    {% if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif %}

    <title>
      {{ page_title }}
      {% if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif %}
      {% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}
      {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- unless settings.heading_font.system? and settings.body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {% render 'social-meta-tags' %}

    {{ 'app.css' | asset_url | stylesheet_tag }}
    {{ 'product-grid.css' | asset_url | stylesheet_tag }}

    {% render 'head-variables' %}

    <script>
		window.theme = window.theme || {};
		theme = {
			settings: {
				money_with_currency_format: {{- shop.money_format | json -}},
				cart_drawer: {{- settings.cart_drawer -}}
			},
			routes: {
				root_url: '{{ routes.root_url }}',
				cart_url: '{{ routes.cart_url }}',
				cart_add_url: '{{ routes.cart_add_url }}',
				search_url: '{{ routes.search_url }}',
				cart_change_url: '{{ routes.cart_change_url }}',
				cart_update_url: '{{ routes.cart_update_url }}',
				predictive_search_url: '{{ routes.predictive_search_url }}',
			},
			variantStrings: {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        preOrder: `{{ 'products.product.pre_order' | t }}`,
      },
			strings: {
				requiresTerms: `{{ 'sections.cart.terms_confirm' | t }}`,
				shippingEstimatorNoResults: `{{ 'sections.cart.shipping_estimator.no_results' | t }}`,
				shippingEstimatorOneResult: `{{ 'sections.cart.shipping_estimator.one_result' | t }}`,
				shippingEstimatorMultipleResults: `{{ 'sections.cart.shipping_estimator.multiple_results' | t }}`,
				shippingEstimatorError: `{{ 'sections.cart.shipping_estimator.error' | t }}`
			}
		};
    </script>
    {{ content_for_header }}
    <!-- Header hook for plugins -->

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
    {{ settings.custom_html_head }}
    {%- liquid
      assign compare = false
      if template.name contains 'collection' or template.name contains 'search'
        if settings.enable_compare and settings.show_compare_toggle_on
          assign compare = true
        endif
      endif
    -%}
    <meta name="google-site-verification" content="OcIdLmPixL4hNUMMxmTOX9vUegXtd9-x6ExWL4_VORM">
    <!-- MailerLite Universal -->
    <script>
      (function (w, d, e, u, f, l, n) {
        (w[f] =
          w[f] ||
          function () {
            (w[f].q = w[f].q || []).push(arguments);
          }),
          (l = d.createElement(e)),
          (l.async = 1),
          (l.src = u),
          (n = d.getElementsByTagName(e)[0]),
          n.parentNode.insertBefore(l, n);
      })(window, document, 'script', 'https://assets.mailerlite.com/js/universal.js', 'ml');
      ml('account', '1820446');
    </script>
    <!-- End MailerLite Universal -->
  </head>
  <body class="animations-{{ settings.animations }} button-uppercase-{{ settings.button_uppercase }} navigation-uppercase-{{ settings.navigation_uppercase }} product-card-spacing-{{ settings.product_card_spacing }} article-card-spacing-{{ settings.article_card_spacing }} compare-{{ compare }}{% if customer %} customer-logged-in{% endif %} template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }} template-{{ template | replace: '.', '-' | handle }}">
    <a class="screen-reader-shortcut" href="#main-content">{{ 'accessibility.skip_to_text' | t }}</a>
    <div id="wrapper">
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}
      <div role="main" id="main-content">
        {{ content_for_layout }}
      </div>
      {% sections 'footer-group' %}
      {% render 'cart-drawer' %}
      {% render 'product-drawer' %}
      {% render 'search-drawer' %}
      <div class="click-capture"></div>
      <div class="click-capture--product"></div>
    </div>

    {{ 'vendor.min.js' | asset_url | script_tag }}
    {% if settings.animations %}
      {{ 'animations.min.js' | asset_url | script_tag }}
      <script>
        gsap.defaults({
          ease: Power4.easeOut,
        });
        gsap.config({
          nullTargetWarn: false,
        });
        gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin);
      </script>
    {% endif %}
    {{ 'slideshow.js' | asset_url | script_tag }}
    {{ 'app.js' | asset_url | script_tag }}
    {{ 'product.js' | asset_url | script_tag }}
    <script type="module" src="{{ 'scroll-shadow.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- if settings.free_shipping -%}
      {{ 'free-shipping.js' | asset_url | script_tag }}
      {{ 'free-shipping.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- if settings.cart_drawer_add_discounts -%}
      {{ 'cart-discounts.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- if request.design_mode -%}
      {{ 'theme-editor.js' | asset_url | script_tag }}
      {% render 'customer-data' %}
    {%- endif -%}
    {%- if settings.cart_terms_conditions_enable -%}
      <script src="{{ 'terms-checkbox.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {% render 'back-to-top' %}
    {%- if settings.preload_links -%}
      {%- unless request.design_mode -%}
        <script type="module" src="{{ 'instant-page.js' | asset_url }}" defer="defer"></script>
      {%- endunless -%}
    {%- endif -%}
    {%- section 'social-sidebar-and-fab' -%}
    <script>
      // Config exportada desde Theme settings
      window.__MAILTO_CFG = {
        to: {{ settings.mailto_to | json }},
        cc: {{ settings.mailto_cc | json }},
        bcc: {{ settings.mailto_bcc | json }},
        subject: {{ settings.mailto_subject | json }},
        bodyTpl: {{ settings.mailto_body | json }},
        selector: {{ settings.mailto_menu_selector | default: 'a[href^="mailto:"]' | json }}
      };
    </script>

    <script>
      (function (cfg) {
        if (!cfg || !cfg.to) return;

        // ---------- Utils ----------
        function normBody(tpl) {
          let out = String(tpl || '');
          out = out.replace(/\r\n?/g, '\n'); // normaliza saltos
          out = out.replace(/[ \t\u00A0]+/g, ' ').trim(); // compacta espacios
          out = out
            .replace(/\{\{url\}\}/g, window.location.href)
            .replace(/\{\{title\}\}/g, document.title)
            .replace(/\{\{referrer\}\}/g, document.referrer || '')
            .replace(/\{\{newline\}\}/g, '\n');
          return out;
        }
        function encBodyForMailto(str) {
          // CRLF para Outlook/Windows
          return encodeURIComponent(str).replace(/%0A/g, '%0D%0A');
        }
        // Partes -> URL mailto
        function buildMailtoFromParts(p) {
          const qs = [];
          if (p.cc) qs.push('cc=' + encodeURIComponent(p.cc));
          if (p.bcc) qs.push('bcc=' + encodeURIComponent(p.bcc));
          if (p.subject) qs.push('subject=' + encodeURIComponent(p.subject));
          if (p.body) qs.push('body=' + encBodyForMailto(p.body));
          return 'mailto:' + (p.to || '') + (qs.length ? '?' + qs.join('&') : '');
        }
        // Lee params del href y MERGEA con cfg
        function parseAndMerge(href) {
          const base = {
            to: cfg.to || '',
            cc: cfg.cc || '',
            bcc: cfg.bcc || '',
            subject: cfg.subject || '',
            body: normBody(cfg.bodyTpl) || '',
          };
          if (href && href.startsWith('mailto:')) {
            const [addrPart, qs] = href.replace(/^mailto:/i, '').split('?');
            if (addrPart) base.to = decodeURIComponent(addrPart);
            const params = new URLSearchParams(qs || '');
            if (params.has('cc')) base.cc = params.get('cc') || base.cc;
            if (params.has('bcc')) base.bcc = params.get('bcc') || base.bcc;
            if (params.has('subject')) base.subject = params.get('subject') || base.subject;
            if (params.has('body')) base.body = params.get('body') || base.body;
          }
          return base;
        }

        // Webmail builders
        // Gmail: abrir compose PEQUEÑO (modal) dentro del inbox
        function gmailURL(p) {
          const qs = new URLSearchParams();
          if (p.to) qs.set('to', p.to);
          if (p.cc) qs.set('cc', p.cc);
          if (p.bcc) qs.set('bcc', p.bcc);
          if (p.subject) qs.set('su', p.subject);
          if (p.body) qs.set('body', String(p.body).replace(/\r\n?/g, '\n')); // saltos estilo Gmail

          // Fuerza el compose flotante dentro del inbox
          return 'https://mail.google.com/mail/u/0/#inbox?compose=new&' + qs.toString();
        }
        function outlookURL(p) {
          const u = new URL('https://outlook.office.com/mail/deeplink/compose');
          if (p.to) u.searchParams.set('to', p.to);
          if (p.cc) u.searchParams.set('cc', p.cc);
          if (p.bcc) u.searchParams.set('bcc', p.bcc);
          if (p.subject) u.searchParams.set('subject', p.subject);
          if (p.body) u.searchParams.set('body', p.body);
          return u.toString();
        }
        function outlookLiveURL(p) {
          const u = new URL('https://outlook.live.com/mail/0/deeplink/compose');
          if (p.to) u.searchParams.set('to', p.to);
          if (p.cc) u.searchParams.set('cc', p.cc);
          if (p.bcc) u.searchParams.set('bcc', p.bcc);
          if (p.subject) u.searchParams.set('subject', p.subject);
          if (p.body) u.searchParams.set('body', p.body);
          return u.toString();
        }
        function yahooURL(p) {
          const u = new URL('https://compose.mail.yahoo.com/');
          if (p.to) u.searchParams.set('to', p.to);
          if (p.subject) u.searchParams.set('subject', p.subject);
          if (p.body) u.searchParams.set('body', p.body);
          return u.toString();
        }
        function webmailURL(kind, p) {
          switch ((kind || 'gmail').toLowerCase()) {
            case 'outlook':
              return outlookURL(p);
            case 'outlook-live':
              return outlookLiveURL(p);
            case 'yahoo':
              return yahooURL(p);
            default:
              return gmailURL(p);
          }
        }

        // Defaults globales (puedes definirlos desde Theme settings)
        const DEFAULT_MODE = (cfg.mode || 'hybrid').toLowerCase(); // native | webmail | hybrid
        const DEFAULT_WEBMAIL = (cfg.webmail || 'gmail').toLowerCase(); // gmail | outlook | outlook-live | yahoo
        const DEFAULT_TARGET = (cfg.webmailTarget || 'self').toLowerCase(); // self | blank

        function openWebmail(kind, parts, target) {
          const url = webmailURL(kind, parts);
          if ((target || 'self') === 'self') {
            window.location.assign(url); // misma pestaña
          } else {
            window.open(url, '_blank', 'noopener'); // nueva pestaña
          }
        }

        const selectors = (cfg.selector || 'a[href^="mailto:"]')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);

        document.addEventListener(
          'click',
          function (e) {
            const a = e.target.closest('a');
            if (!a) return;
            if (
              !selectors.some((sel) => {
                try {
                  return a.matches(sel);
                } catch {
                  return false;
                }
              })
            )
              return;

            const mode = a.dataset.mailtoMode || DEFAULT_MODE;
            const kind = a.dataset.webmail || DEFAULT_WEBMAIL;
            const target = a.dataset.webmailTarget || DEFAULT_TARGET;

            // MERGE cfg + href del enlace
            const parts = parseAndMerge(a.getAttribute('href') || '');
            const mailto = buildMailtoFromParts(parts);

            if (mode === 'webmail') {
              e.preventDefault();
              openWebmail(kind, parts, target);
              return;
            }
            if (mode === 'native') {
              a.setAttribute('href', mailto); // asegura params completos
              return; // deja actuar al handler del sistema/navegador
            }

            // ---- HYBRID: mailto + fallback si NO hay handler ----
            e.preventDefault();

            let lostFocus = false;
            let navigated = false;

            const onBlur = () => {
              lostFocus = true;
            };
            const onVC = () => {
              if (document.visibilityState === 'hidden') navigated = true;
            };
            const onPH = () => {
              navigated = true;
            };

            window.addEventListener('blur', onBlur, { once: true });
            document.addEventListener('visibilitychange', onVC, { once: true });
            window.addEventListener('pagehide', onPH, { once: true });

            // Dispara nativo sin navegar esta pestaña
            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.width = 0;
            iframe.height = 0;
            iframe.tabIndex = -1;
            document.body.appendChild(iframe);
            try {
              iframe.src = mailto;
            } catch {}

            setTimeout(function () {
              // Si perdimos foco o la página se ocultó, NO abrir fallback
              const shouldFallback =
                !(lostFocus || navigated || document.visibilityState === 'hidden' || !document.hasFocus()) &&
                !(e.ctrlKey || e.metaKey || e.shiftKey || e.altKey);

              if (shouldFallback) {
                openWebmail(kind, parts, target); // por defecto 'self'
              }

              try {
                document.body.removeChild(iframe);
              } catch {}
            }, 700);
          },
          { passive: false }
        );

        // Helper de prueba en consola
        window.__MAILTO_TEST = () => {
          const url = buildMailtoFromParts(parseAndMerge(''));
          console.log('[mailto test]', decodeURIComponent(url));
          return url;
        };
      })(window.__MAILTO_CFG || {});
    </script>
  </body>
</html>
