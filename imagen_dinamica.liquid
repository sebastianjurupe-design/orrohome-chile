{% comment %}
  Section: Imagen dinámica (desktop + mobile)
  - Mobile visible solo hasta 900px
  - Contenedor con width/height configurables (unidad: %, px, rem, vh, vw)
  - object-fit: contain | cover | fill
{% endcomment %}

<style>
  .imgd-section {
    margin-inline: auto;
    width: 1560px;
    max-width: 97%;
    margin: 0 auto;
  }
</style>

<section class="imgd-section" id="section-{{ section.id }}">
  {% assign desk = section.settings.desktop_img %}
  {% assign mobi = section.settings.mobile_img %}
  {% assign alt = section.settings.alt_text | default: desk.alt | default: mobi.alt | default: shop.name %}

  {%- comment -%} Construye estilos del contenedor {%- endcomment -%}
  {%- comment -%} Construye estilos del contenedor {%- endcomment -%}
  {% capture container_style %}
  {%- if section.settings.width_value != blank -%}
    width: {{ section.settings.width_value }}{{ section.settings.width_unit }};
  {%- endif -%}

  {%- if section.settings.height_unit == 'auto' or section.settings.height_value == blank -%}
    height: auto; --img-h:auto;
  {%- else -%}
    height: {{ section.settings.height_value }}{{ section.settings.height_unit }}; --img-h:100%;
  {%- endif -%}
{% endcapture %}
  {% assign container_style = container_style | strip | replace: '  ', ' ' %}

  <div class="imgd-wrap" style="{{ container_style }} --ofit: {{ section.settings.object_fit }};">
    {%- comment -%} Desktop IMG (se oculta <=900px si hay mobile) {%- endcomment -%}
    {% if desk %}
      <img
        class="imgd-img imgd-desktop{% if mobi %} imgd-desktop--has-mobile{% endif %}"
        src="{{ desk | image_url: width: 1600 }}"
        srcset="
          {{ desk | image_url: width: 480 }} 480w,
          {{ desk | image_url: width: 768 }} 768w,
          {{ desk | image_url: width: 1200 }} 1200w,
          {{ desk | image_url: width: 1600 }} 1600w,
          {{ desk | image_url: width: 2000 }} 2000w
        "
        sizes="(max-width: 900px) 0px, 100vw"
        alt="{{ alt | escape }}"
        loading="lazy"
        width="{{ desk.width }}"
        height="{{ desk.height }}"
      >
    {% endif %}

    {%- comment -%} Mobile IMG (solo visible <=900px) {%- endcomment -%}
    {% if mobi %}
      <img
        class="imgd-img imgd-mobile"
        src="{{ mobi | image_url: width: 900 }}"
        srcset="
          {{ mobi | image_url: width: 320 }} 320w,
          {{ mobi | image_url: width: 480 }} 480w,
          {{ mobi | image_url: width: 720 }} 720w,
          {{ mobi | image_url: width: 900 }} 900w
        "
        sizes="(max-width: 900px) 100vw, 0px"
        alt="{{ alt | escape }}"
        loading="lazy"
        width="{{ mobi.width }}"
        height="{{ mobi.height }}"
      >
    {% endif %}
  </div>

  <style>
    #section-{{ section.id }} .imgd-wrap {
      position: relative;
      overflow: hidden;
      /* Si no se define height, mantenemos relación natural del <img> cuando object-fit=contain/cover/fill */
    }
    #section-{{ section.id }} .imgd-img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: var(--ofit);
      object-position: center center;
    }

    /* Visibilidad por breakpoint */
    #section-{{ section.id }} .imgd-mobile { display: none; }
    @media (max-width: 900px) {
      #section-{{ section.id }} .imgd-mobile { display: block; }
      #section-{{ section.id }} .imgd-desktop--has-mobile { display: none; }
    }
  </style>
</section>

{% schema %}
{
  "name": "Imagen dinámica",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_img",
      "label": "Imagen desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_img",
      "label": "Imagen mobile (visible hasta 900px)"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (alt)",
      "info": "Si se deja vacío, usa el alt de la imagen o el nombre de la tienda como fallback."
    },

    {
      "type": "header",
      "content": "Tamaño del contenedor"
    },
    {
      "type": "text",
      "id": "width_value",
      "label": "Width (valor)",
      "default": "200",
      "info": "Ej: 100, 120, 80 (deja vacío para auto)"
    },
    {
      "type": "select",
      "id": "width_unit",
      "label": "Width (unidad)",
      "default": "%",
      "options": [
        { "value": "%", "label": "%" },
        { "value": "px", "label": "px" },
        { "value": "rem", "label": "rem" },
        { "value": "vh", "label": "vh" },
        { "value": "vw", "label": "vw" }
      ]
    },
    {
      "type": "text",
      "id": "height_value",
      "label": "Height (valor)",
      "default": "200",
      "info": "Ej: 300, 50, 100 (deja vacío para auto). Nota: para object-fit:cover/contain/fill, el contenedor debe tener height si quieres recorte/adaptación visible."
    },
    {
      "type": "select",
      "id": "height_unit",
      "label": "Height (unidad)",
      "default": "px",
      "options": [
        { "value": "px", "label": "px" },
        { "value": "%", "label": "%" },
        { "value": "rem", "label": "rem" },
        { "value": "vh", "label": "vh" },
        { "value": "vw", "label": "vw" }
      ]
    },

    {
      "type": "header",
      "content": "Ajuste de la imagen"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Object-fit",
      "default": "cover",
      "options": [
        { "value": "contain", "label": "contain" },
        { "value": "cover", "label": "cover" },
        { "value": "fill", "label": "fill" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Imagen dinámica",
      "category": "Imagen"
    }
  ]
}
{% endschema %}
